extends "@DRIVE_SCRIPT@"

class FakePatrol extends Node3D:
	var spawn_world:=Vector3.ZERO
	var spawn_source:=Vector3.ZERO
	var manual_input:=false
	var manual_ground_on_carrier:=false
	var session:Dictionary={"first_fall":null,"error":""}
	var _base:Node3D
	var _taps:Array=[]
	func _ready()->void:_base=Node3D.new();add_child(_base)
	func _add_tap(action:String)->void:_taps.append(action)

class RemotePatrol extends Node3D:
	var destination:Dictionary={}
	var rendered_carrier:=Transform3D.IDENTITY
	var camera_snap_pending:=true
	var _base:Node3D
	func _ready()->void:_base=Node3D.new();add_child(_base)
	func set_destination(value:Dictionary)->void:destination=value

class FakeCockpit:
	var ui_axes:={"throttle":1.,"steer":1.,"brake":1.}

var last_md_script:=""
var inspected_md:Node=null
func _make_manual_md(kind:String)->Node:
	last_md_script=_manual_md_script(kind)
	if inspected_md!=null:inspected_md.free();inspected_md=null
	inspected_md=load(last_md_script).new()
	var fake:=FakePatrol.new();fake.manual_input=true
	return fake

var captured_sai_destination:Dictionary={}
func _respawn_sai_at(_kind:String,destination:Dictionary)->void:
	captured_sai_destination=destination

func _initialize()->void:call_deferred("_run_probe")
func _physics_process(_dt:float)->bool:return false

func _run_probe()->void:
	stage=Node3D.new();root.add_child(stage)
	bodies={"front":RigidBody3D.new(),"tail":RigidBody3D.new()}
	for body in bodies.values():stage.add_child(body)
	bodies.tail.position=Vector3(-84.,0.,0.)
	camera=Camera3D.new();stage.add_child(camera)
	for action in ["sainiverse_forward","sainiverse_reverse","sainiverse_left","sainiverse_right"]:
		if not InputMap.has_action(action):InputMap.add_action(action)
	spec={"contact":{"interior":{"datum_source_m":[0.,0.,0.]}}}
	patrol=FakePatrol.new();stage.add_child(patrol)
	active_robot_kind="microduck";manual=true;camera_ready=true
	for key in [KEY_F1,KEY_F2,KEY_F3]:
		var event:=InputEventKey.new();event.physical_keycode=key;event.keycode=key;event.pressed=true
		handle_input(event)
		if patrol._taps.size()!=[KEY_F1,KEY_F2,KEY_F3].find(key)+1:
			printerr("FAIL: quick-travel key did not reset the active MicroDuck")
			quit(1);return
		if key==KEY_F1 and (absf(patrol.spawn_world.x)>.001 or absf(patrol.spawn_world.z-25.5)>.001 or patrol.manual_ground_on_carrier):
			printerr("FAIL: F1 snow spawn is not beside the front boarding lift")
			quit(1);return
		if key==KEY_F1:
			_manual_robot_camera(Vector3(3.,0.,103.)) # Old robot pose before reset completes.
			if active_quick_location!=1 or camera.global_position.y<20.:
				printerr("FAIL: F1 whole-car camera ended before the robot arrived")
				quit(1);return
	if patrol.spawn_source!=Vector3(25.,0.,11.354) or not patrol.manual_ground_on_carrier:
		printerr("FAIL: F3 did not select the carrier cockpit spawn")
		quit(1);return
	active_robot_kind="roller"
	quick_travel(2)
	if patrol.spawn_source!=Vector3(-12.,-12.5,7.454):
		printerr("FAIL: F2 did not select the carrier deck for the roller")
		quit(1);return
	var remote:=RemotePatrol.new();stage.add_child(remote);patrol=remote
	quick_travel(2)
	if remote.destination.is_empty() or not remote.destination.carrier_surface:
		printerr("FAIL: F2 did not route the carrier deck to the independent robot")
		quit(1);return
	remote._base.global_position=remote.destination.world
	manual_camera_target_valid=false
	_manual_robot_camera(remote.destination.world)
	var remote_before:Vector3=camera.global_position
	var remote_press:=InputEventMouseButton.new();remote_press.button_index=MOUSE_BUTTON_RIGHT;remote_press.pressed=true
	handle_input(remote_press)
	var remote_motion:=InputEventMouseMotion.new();remote_motion.relative=Vector2(80.,0.)
	handle_input(remote_motion);_manual_robot_camera(remote.destination.world)
	var remote_release:=InputEventMouseButton.new();remote_release.button_index=MOUSE_BUTTON_RIGHT;remote_release.pressed=false
	handle_input(remote_release)
	if active_quick_location!=0 or camera.global_position.distance_to(remote_before)<.2:
		printerr("FAIL: independent MD camera did not leave the F2 fixed view on right-drag")
		quit(1);return
	patrol=null
	sai_passenger=Node3D.new();stage.add_child(sai_passenger)
	active_robot_kind="sai001"
	quick_travel(3)
	await process_frame
	if captured_sai_destination.is_empty() or not captured_sai_destination.carrier_surface:
		printerr("FAIL: F3 did not respawn Sai in the cockpit")
		quit(1);return
	_manual_robot_camera(Vector3(3.,4.,5.))
	if camera.global_position.distance_to(Vector3(3.,4.,5.))>2.:
		printerr("FAIL: cockpit camera leaves the robot behind the cabin wall")
		quit(1);return
	sai_passenger=null
	patrol=FakePatrol.new();stage.add_child(patrol)
	active_robot_kind="microduck"
	robot_switch_busy=false
	for station in [1,2,3]:
		quick_travel(station)
		var target:Vector3=_quick_destination(station,"microduck").world
		patrol._base.global_position=target
		_manual_robot_camera(target)
		var before:Vector3=camera.global_position
		var press:=InputEventMouseButton.new();press.button_index=MOUSE_BUTTON_RIGHT;press.pressed=true
		handle_input(press)
		var motion:=InputEventMouseMotion.new();motion.relative=Vector2(80.,0.)
		handle_input(motion)
		_manual_robot_camera(target)
		var release:=InputEventMouseButton.new();release.button_index=MOUSE_BUTTON_RIGHT;release.pressed=false
		handle_input(release)
		var expected_location:int=1 if station==1 else 0
		if active_quick_location!=expected_location or camera.global_position.distance_to(before)<.2 or (station==1 and camera.global_position.distance_to(target)<50.):
			printerr("FAIL: right-drag does not rotate the MD camera after F",station,
				" location=",active_quick_location," dragged=",f1_panorama_dragged,
				" camera_delta=",camera.global_position.distance_to(before))
			quit(1);return
		var before_zoom:Vector3=camera.global_position
		var zoom:=InputEventMouseButton.new();zoom.button_index=MOUSE_BUTTON_WHEEL_UP;zoom.pressed=true
		handle_input(zoom);_manual_robot_camera(target)
		if camera.global_position.distance_to(before_zoom)<.05:
			printerr("FAIL: mouse wheel does not zoom the MD camera after F",station)
			quit(1);return
	print("PASS: F1–F3 respawns and MD right-drag/zoom camera controls")
	cockpit=FakeCockpit.new()
	OS.set_environment("SAINIVERSE_REMOTE_MD_PREVIEW","")
	OS.set_environment("SAINIVERSE_REMOTE_PROBE","")
	if _manual_md_remote_preview("microduck") or _manual_md_remote_preview("roller"):
		printerr("FAIL: headless manual MD used the desktop remote worker without a probe")
		quit(1);return
	await _switch_robot_mode("microduck")
	if Engine.physics_ticks_per_second!=200 or Engine.max_physics_steps_per_frame!=16 or not bodies.front.freeze or not parked_patrol_fixture or physics_interpolation:
		printerr("FAIL: headless F5 MicroDuck is not the parked 200 Hz patrol fixture")
		quit(1);return
	if cockpit.ui_axes.throttle!=0. or not str(last_md_script).ends_with("microduck_patrol.gd"):
		printerr("FAIL: headless F5 did not instantiate microduck_patrol.gd")
		quit(1);return
	await _switch_robot_mode("roller")
	if Engine.physics_ticks_per_second!=200 or not bodies.front.freeze or not parked_patrol_fixture or not str(last_md_script).ends_with("microduck_patrol.gd"):
		printerr("FAIL: headless F6 roller is not the collidable patrol fixture")
		quit(1);return
	cockpit.ui_axes={"throttle":1.,"steer":1.,"brake":1.}
	OS.set_environment("SAINIVERSE_REMOTE_PROBE","1")
	if not _manual_md_remote_preview("microduck") or not _manual_md_remote_preview("roller"):
		printerr("FAIL: manual MD probe did not select the independent robot")
		quit(1);return
	await _switch_robot_mode("microduck")
	if Engine.physics_ticks_per_second!=60 or Engine.max_physics_steps_per_frame!=12 or bodies.front.freeze or parked_patrol_fixture or not physics_interpolation:
		printerr("FAIL: F5 MicroDuck freezes or slows the vehicle")
		quit(1);return
	if active_quick_location!=3 or int(quick_travel_history[-1].station)!=3:
		printerr("FAIL: selected MD did not wake in the cockpit")
		quit(1);return
	if cockpit.ui_axes.throttle!=1. or not str(last_md_script).ends_with("microduck_remote.gd"):
		printerr("FAIL: F5 did not instantiate the independent MicroDuck")
		quit(1);return
	if inspected_md==null or not inspected_md.has_method("set_destination") or inspected_md.get_script()==null or not str(inspected_md.get_script().resource_path).ends_with("microduck_remote.gd"):
		printerr("FAIL: F5 did not create the independent MicroDuck node")
		quit(1);return
	await _switch_robot_mode("roller")
	if Engine.physics_ticks_per_second!=60 or bodies.front.freeze or parked_patrol_fixture or not str(last_md_script).ends_with("microduck_remote.gd"):
		printerr("FAIL: F6 roller freezes the vehicle")
		quit(1);return
	OS.set_environment("SAINIVERSE_SAI60_POLICY","five-up24-native6060")
	if not _manual_carrier_live("sai001",false) or not _manual_carrier_live("sai002",false):
		printerr("FAIL: Sai 60 Hz mode freezes the vehicle")
		quit(1);return
	OS.set_environment("SAINIVERSE_SAI60_POLICY","")
	OS.set_environment("SAINIVERSE_REMOTE_MD_PREVIEW","1")
	if _manual_md_remote_preview("sai001") or _manual_md_remote_preview("vehicle"):
		printerr("FAIL: remote MD preview leaked onto a non-MicroDuck mode")
		quit(1);return
	cockpit.ui_axes={"throttle":1.,"steer":1.,"brake":1.}
	await _switch_robot_mode("microduck")
	if Engine.physics_ticks_per_second!=60 or Engine.max_physics_steps_per_frame!=12 or bodies.front.freeze or parked_patrol_fixture or not physics_interpolation:
		printerr("FAIL: SAINIVERSE_REMOTE_MD_PREVIEW did not restore the remote MD runtime")
		quit(1);return
	if cockpit.ui_axes.throttle!=1. or not str(last_md_script).ends_with("microduck_remote.gd"):
		printerr("FAIL: remote MD preview did not instantiate microduck_remote.gd")
		quit(1);return
	if inspected_md==null or not inspected_md.has_method("set_destination") or not inspected_md.has_method("apply_visual_style") or inspected_md.get_script()==null or not str(inspected_md.get_script().resource_path).ends_with("microduck_remote.gd"):
		printerr("FAIL: remote MD preview instance is not microduck_remote.gd")
		quit(1);return
	OS.set_environment("SAINIVERSE_REMOTE_MD_PREVIEW","")
	OS.set_environment("SAINIVERSE_REMOTE_PROBE","")
	if inspected_md!=null:inspected_md.free();inspected_md=null
	print("PASS: headless patrol remains available; F5/F6 remote MD keep the vehicle live")
	quit(0)
