extends "@DRIVE_SCRIPT@"

class FakePatrol extends Node3D:
	var spawn_world:=Vector3.ZERO
	var spawn_source:=Vector3.ZERO
	var manual_ground_on_carrier:=false
	var _base:Node3D
	var _taps:Array=[]
	func _ready()->void:_base=Node3D.new();add_child(_base)
	func _add_tap(action:String)->void:_taps.append(action)

var captured_sai_destination:Dictionary={}
func _respawn_sai_at(_kind:String,destination:Dictionary)->void:
	captured_sai_destination=destination

func _initialize()->void:call_deferred("_run_probe")
func _physics_process(_dt:float)->bool:return false

func _run_probe()->void:
	stage=Node3D.new();root.add_child(stage)
	bodies={"front":RigidBody3D.new(),"tail":RigidBody3D.new()}
	for body in bodies.values():stage.add_child(body)
	bodies.tail.position=Vector3(-84.,0.,0.)
	camera=Camera3D.new();stage.add_child(camera)
	for action in ["sainiverse_forward","sainiverse_reverse","sainiverse_left","sainiverse_right"]:
		if not InputMap.has_action(action):InputMap.add_action(action)
	spec={"contact":{"interior":{"datum_source_m":[0.,0.,0.]}}}
	patrol=FakePatrol.new();stage.add_child(patrol)
	active_robot_kind="microduck";manual=true;camera_ready=true
	for key in [KEY_F1,KEY_F2,KEY_F3]:
		var event:=InputEventKey.new();event.physical_keycode=key;event.keycode=key;event.pressed=true
		handle_input(event)
		if patrol._taps.size()!=[KEY_F1,KEY_F2,KEY_F3].find(key)+1:
			printerr("FAIL: quick-travel key did not reset the active MicroDuck")
			quit(1);return
		if key==KEY_F1 and (absf(patrol.spawn_world.x)>.001 or absf(patrol.spawn_world.z-25.5)>.001 or patrol.manual_ground_on_carrier):
			printerr("FAIL: F1 snow spawn is not beside the front boarding lift")
			quit(1);return
		if key==KEY_F1:
			_manual_robot_camera(Vector3(3.,0.,103.)) # Old robot pose before reset completes.
			if active_quick_location!=1 or camera.global_position.y<20.:
				printerr("FAIL: F1 whole-car camera ended before the robot arrived")
				quit(1);return
	if patrol.spawn_source!=Vector3(25.,0.,11.354) or not patrol.manual_ground_on_carrier:
		printerr("FAIL: F3 did not select the carrier cockpit spawn")
		quit(1);return
	active_robot_kind="roller"
	quick_travel(2)
	if patrol.spawn_source!=Vector3(-12.,-12.5,7.454):
		printerr("FAIL: F2 did not select the carrier deck for the roller")
		quit(1);return
	patrol=null
	sai_passenger=Node3D.new();stage.add_child(sai_passenger)
	active_robot_kind="sai001"
	quick_travel(3)
	await process_frame
	if captured_sai_destination.is_empty() or not captured_sai_destination.carrier_surface:
		printerr("FAIL: F3 did not respawn Sai in the cockpit")
		quit(1);return
	_manual_robot_camera(Vector3(3.,4.,5.))
	if camera.global_position.distance_to(Vector3(3.,4.,5.))>2.:
		printerr("FAIL: cockpit camera leaves the robot behind the cabin wall")
		quit(1);return
	sai_passenger=null
	patrol=FakePatrol.new();stage.add_child(patrol)
	active_robot_kind="microduck"
	robot_switch_busy=false
	for station in [1,2,3]:
		quick_travel(station)
		var target:Vector3=_quick_destination(station,"microduck").world
		patrol._base.global_position=target
		_manual_robot_camera(target)
		var before:Vector3=camera.global_position
		var yaw_before:float=orbit_yaw
		var press:=InputEventMouseButton.new();press.button_index=MOUSE_BUTTON_RIGHT;press.pressed=true
		handle_input(press)
		var motion:=InputEventMouseMotion.new();motion.relative=Vector2(80.,0.)
		handle_input(motion)
		_manual_robot_camera(target)
		var release:=InputEventMouseButton.new();release.button_index=MOUSE_BUTTON_RIGHT;release.pressed=false
		handle_input(release)
		var expected_location:int=1 if station==1 else 0
		if active_quick_location!=expected_location or (station!=1 and is_equal_approx(orbit_yaw,yaw_before)) or camera.global_position.distance_to(before)<.2 or (station==1 and camera.global_position.distance_to(target)<50.):
			printerr("FAIL: right-drag does not rotate the MD camera after F",station,
				" location=",active_quick_location," dragged=",f1_panorama_dragged,
				" camera_delta=",camera.global_position.distance_to(before))
			quit(1);return
		var before_zoom:Vector3=camera.global_position
		var zoom:=InputEventMouseButton.new();zoom.button_index=MOUSE_BUTTON_WHEEL_UP;zoom.pressed=true
		handle_input(zoom);_manual_robot_camera(target)
		if camera.global_position.distance_to(before_zoom)<.05:
			printerr("FAIL: mouse wheel does not zoom the MD camera after F",station)
			quit(1);return
	print("PASS: F1–F3 respawns and MD right-drag/zoom camera controls")
	quit(0)
